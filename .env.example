# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Proxy for yfinance / foreign data fetching (HTTP/HTTPS)
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
# Bypass proxy for domestic Chinese data sources
NO_PROXY=localhost,127.0.0.1,tushare.pro,eastmoney.com.cn,eastmoney.com,sina.com.cn,sina.com,10jqka.com.cn,dfcfw.com

# Optional: override DEFAULT_CONFIG without editing code.
# Any QUANTCONCLAVE_* variable below, when set, replaces the matching key
# in quantconclave/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
QUANTCONCLAVE_LLM_PROVIDER=deepseek
QUANTCONCLAVE_DEEP_THINK_LLM=deepseek-v4-pro
QUANTCONCLAVE_QUICK_THINK_LLM=deepseek-v4-flash
#QUANTCONCLAVE_LLM_BACKEND_URL=
#QUANTCONCLAVE_OUTPUT_LANGUAGE=English
#QUANTCONCLAVE_MAX_DEBATE_ROUNDS=1
#QUANTCONCLAVE_MAX_RISK_ROUNDS=1
#QUANTCONCLAVE_CHECKPOINT_ENABLED=false

# Tushare token for capital flow / money flow data (东方财富 source)
TUSHARE_TOKEN=your-tushare-token
